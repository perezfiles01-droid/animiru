# Backend API Configuration
API_BASE_URL=http://localhost:3001/api
API_BACKEND_PORT=3001

# Frontend Configuration
REACT_APP_API_URL=http://localhost:3001/api
REACT_APP_PUBLIC_URL=/

# Database Configuration - Firebase
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_firebase_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_firebase_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_firebase_sender_id
FIREBASE_APP_ID=your_firebase_app_id

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=7d

# AniList API Configuration
ANILIST_URL=https://graphql.anilist.co
ANILIST_API_KEY=your_anilist_api_key_if_required

# Environment
NODE_ENV=development
REACT_APP_ENV=development

# Logging
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=your_session_secret_key
SESSION_TIMEOUT=86400000

# Video Quality Options
DEFAULT_VIDEO_QUALITY=auto
ALLOWED_QUALITIES=1080p,720p,480p,auto

# Feature Flags
FEATURE_CACHE_ANIME=true
CACHE_TTL_HOURS=1

# APK Configuration (for mobile build)
APK_VERSION=1.0.0
APK_BUILD_NUMBER=1
KEYSTORE_PATH=./keystore.jks
KEYSTORE_PASSWORD=your_keystore_password
KEY_ALIAS=your_key_alias
KEY_PASSWORD=your_key_password
